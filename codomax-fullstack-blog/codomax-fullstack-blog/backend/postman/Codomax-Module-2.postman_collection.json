          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Read my blog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blogs",
            "{{blogId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Update blog",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blogs",
            "{{blogId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My updated Module 2 blog\",\n  \"category\": \"Web Development\",\n  \"content\": \"This blog was created through the Node.js and Express REST API.\",\n  \"author\": \"Jafeer Abdullah\",\n  \"imageUrl\": \"images/code-workspace.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Delete blog",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/blogs/{{blogId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blogs",
            "{{blogId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Reject create without login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/blogs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "blogs"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My Module 2 blog\",\n  \"category\": \"Web Development\",\n  \"content\": \"This blog was created through the Node.js and Express REST API.\",\n  \"author\": \"Jafeer Abdullah\",\n  \"imageUrl\": \"images/code-workspace.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    }
  ]
}
